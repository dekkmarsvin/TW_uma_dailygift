# Environment Variables Template
# Copy this file to .env and fill in your actual values

# UMA Login Credentials
login_username=your_email@example.com
login_password=your_password_here

# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (recommended: gemini-3-flash-preview)
model=gemini-3-flash-preview

# UMA Match overall sunset time. After this time, umamatch automation exits successfully without network/browser work.
# Default: 2026-07-06T04:59:00+08:00
UMAMATCH_SUNSET_AT=2026-07-06T04:59:00+08:00

# UMA Match task reward sunset time. After this time, task claiming is skipped while lottery can still run.
# Default: 2026-06-29T04:59:00+08:00
UMAMATCH_TASK_SUNSET_AT=2026-06-29T04:59:00+08:00
